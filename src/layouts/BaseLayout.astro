---
const { title = 'Akhilesh Palve | Cybersecurity', description = 'Cybersecurity portfolio, field notes, and practical security research by Akhilesh Palve.' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0b100e" /><meta name="description" content={description} />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body><div class="site-shell">
<header class="topbar"><a class="brand" href="/" aria-label="Akhilesh Palve home"><span class="green">0x</span> akhil<span class="muted">.sec</span></a><nav aria-label="Main navigation"><a href="/#about">about</a><a href="/#work">work</a><a href="/#projects">projects</a><a href="/blog/">field notes</a><a href="/#contact">contact</a></nav><a class="availability" href="/#contact"><span></span> open to opportunities</a></header>
<main><slot /></main>
<footer class="footer"><span>© {year} Akhilesh Palve</span><span>Built with Astro <span class="green">/</span> deployed with GitHub Pages</span><a href="https://github.com/Akhileshpalve89" target="_blank" rel="noreferrer">source ↗</a></footer>
</div></body></html>
<style is:global>
:root{color-scheme:dark;--bg:#0b100e;--panel:#101713;--line:#25352b;--text:#e7eee9;--muted:#91a197;--green:#9de5ad;--green-strong:#65d983;--mono:'DM Mono',monospace;--sans:'Inter',system-ui,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:radial-gradient(ellipse at 80% 0%,#14221a 0,transparent 34rem),var(--bg);color:var(--text);font-family:var(--sans);line-height:1.7}a{color:inherit;text-decoration:none}a:hover{color:var(--green)}::selection{background:var(--green);color:#07100a}.site-shell{width:min(1120px,calc(100% - 40px));margin:auto}.topbar{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line);font-family:var(--mono);font-size:.82rem}.brand{font-size:1.05rem;font-weight:500;letter-spacing:-.04em;white-space:nowrap}.green{color:var(--green)}.muted{color:var(--muted)}nav{display:flex;gap:22px;flex-wrap:wrap;color:var(--muted)}.availability{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:.72rem;white-space:nowrap}.availability span{width:7px;height:7px;background:var(--green-strong);border-radius:50%;box-shadow:0 0 12px #65d98370}main{min-height:65vh}.eyebrow{display:flex;align-items:center;gap:10px;color:var(--green);font:.78rem var(--mono);text-transform:uppercase;letter-spacing:.08em}.eyebrow:before{content:'';width:22px;height:1px;background:var(--green)}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(2.6rem,7vw,5.3rem);letter-spacing:-.075em;line-height:1.04;margin:22px 0;max-width:850px}h2{font-size:clamp(1.55rem,3vw,2.2rem);letter-spacing:-.05em;line-height:1.2;margin-bottom:14px}h3{font-size:1.05rem;letter-spacing:-.025em}p{color:var(--muted)}.hero{padding:92px 0 74px;border-bottom:1px solid var(--line)}.hero .lead{max-width:700px;font-size:1.1rem;line-height:1.9}.hero h1 .accent{color:var(--green)}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.button{display:inline-flex;align-items:center;gap:10px;padding:11px 16px;border:1px solid var(--line);border-radius:7px;font:.8rem var(--mono);transition:transform .15s,border-color .15s}.button:hover{border-color:var(--green);transform:translateY(-2px)}.button.primary{color:#07100a;background:var(--green);border-color:var(--green);font-weight:500}.terminal{margin-top:42px;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#0a0e0c;box-shadow:0 18px 70px #0002}.terminal-bar{display:flex;align-items:center;gap:7px;padding:12px 15px;border-bottom:1px solid var(--line);color:var(--muted);font:.72rem var(--mono)}.dot{width:7px;height:7px;border-radius:50%;background:#4b6253}.terminal-body{padding:18px 20px;font:.8rem/1.9 var(--mono);color:#a7b6ab}.prompt{color:var(--green)}.terminal-body .output{color:var(--text)}.section{padding:72px 0;border-bottom:1px solid var(--line)}.section-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:28px}.section-head p{max-width:470px;margin-bottom:0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.card{border:1px solid var(--line);background:linear-gradient(140deg,#121a15,#0e1411);border-radius:10px;padding:23px;min-width:0}.card:hover{border-color:#486650}.card-meta{color:var(--green);font:.7rem var(--mono);text-transform:uppercase;letter-spacing:.05em}.card h3{margin:12px 0 8px}.card p{margin-bottom:0;font-size:.92rem}.tag-list{display:flex;flex-wrap:wrap;gap:7px;margin-top:17px}.tag{border:1px solid var(--line);color:#aab8ad;padding:3px 8px;border-radius:4px;font:.68rem var(--mono)}.split{display:grid;grid-template-columns:.7fr 1.3fr;gap:60px}.skill-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.skill-group{border-top:1px solid var(--line);padding-top:15px}.skill-group h3{font:.8rem var(--mono);color:var(--green)}.skill-group p{font-size:.88rem;margin-bottom:0}.contact-panel{display:flex;align-items:center;justify-content:space-between;gap:24px;border:1px solid var(--line);background:var(--panel);padding:30px;border-radius:10px}.contact-panel p{margin-bottom:0}.footer{display:flex;justify-content:space-between;gap:18px;padding:24px 0 34px;color:var(--muted);font:.72rem var(--mono);flex-wrap:wrap}.post-list{display:grid;gap:12px}.post-row{display:grid;grid-template-columns:120px 1fr auto;align-items:start;gap:22px;padding:22px;border:1px solid var(--line);border-radius:9px;background:#101713a8}.post-date{color:var(--muted);font:.72rem var(--mono);padding-top:3px}.post-row h3{margin:0 0 6px}.post-row p{margin:0;font-size:.9rem}.post-arrow{color:var(--green);font:1rem var(--mono)}.page-intro{padding:70px 0 38px}.article{max-width:760px;margin:0 auto;padding:54px 0 90px}.article h1{font-size:clamp(2.3rem,5vw,4rem)}.article .article-description{font-size:1.1rem}.article-meta{display:flex;gap:12px;flex-wrap:wrap;color:var(--muted);font:.75rem var(--mono);margin:22px 0 36px}.prose{font-size:1rem;line-height:1.85}.prose h2{margin-top:2.2em}.prose h3{margin-top:1.8em}.prose li{color:#bdc9c0;padding-left:5px;margin:7px 0}.prose ul,.prose ol{padding-left:24px}.prose strong{color:var(--text)}.prose code{background:#17221a;color:var(--green);padding:2px 5px;border-radius:4px;font:.86em var(--mono)}.prose pre{overflow:auto;border:1px solid var(--line);border-radius:8px;padding:18px;background:#070b09}.prose pre code{background:none;padding:0}.back-link{color:var(--green);font:.78rem var(--mono)}
@media(max-width:780px){.topbar{align-items:flex-start;padding:17px 0;flex-wrap:wrap}nav{order:3;width:100%;gap:15px}.availability{margin-left:auto}.hero{padding:65px 0 52px}.split{grid-template-columns:1fr;gap:25px}.grid,.skill-groups{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column}.post-row{grid-template-columns:1fr auto;gap:8px 14px}.post-date{grid-column:1/-1}.contact-panel{align-items:flex-start;flex-direction:column}}
@media(max-width:440px){.site-shell{width:min(calc(100% - 26px),1120px)}.availability{display:none}.terminal-body{padding:14px;font-size:.72rem}.card{padding:19px}.post-row{padding:17px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important}}
</style>
