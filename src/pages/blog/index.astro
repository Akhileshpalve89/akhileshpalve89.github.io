---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Field Notes | Akhilesh Palve" description="Practical cybersecurity field notes on Active Directory, phishing triage, cloud security, and defensive engineering."><section class="page-intro"><div class="eyebrow">Knowledge base / 0xFIELDNOTES</div><h1>Security <span style="color:var(--green)">field notes.</span></h1><p class="lead" style="max-width:680px">Practical write-ups from labs, investigations, and security research. Focused on repeatable methods, clear evidence, and useful defensive takeaways.</p><p style="font: .75rem var(--mono); color:var(--muted)">ROOT: /blog · ARTICLES: {posts.length} · FORMAT: MARKDOWN</p></section><section class="section" style="padding-top:10px;border-bottom:0"><div class="post-list">{posts.map((post) => <a class="post-row" href={'/blog/' + post.slug + '/'}><div class="post-date">{post.data.pubDate.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'})}<br />{post.data.readTime ?? 'Field note'}</div><div><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="tag-list">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div><span class="post-arrow">↗</span></a>)}</div></section></BaseLayout>
