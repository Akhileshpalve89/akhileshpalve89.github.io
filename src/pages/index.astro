---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const projects = [
 { title:'Phishing Email Detection Extension', meta:'THREAT INTELLIGENCE', text:'A privacy-focused browser extension combining OSINT and threat-intelligence signals to help identify suspicious email links and indicators.', tags:['JavaScript','OSINT','VirusTotal','AbuseIPDB'] },
 { title:'MACS — Multi-Agentic Cloud Security', meta:'CLOUD SECURITY / AI', text:'A modular cloud security concept using agentic workflows to assess cloud posture, container images, virtual machines, and infrastructure-as-code controls.', tags:['Python','Cloud Security','AI Agents'] },
 { title:'Cyber Triage & Digital Forensics', meta:'DIGITAL FORENSICS', text:'A triage-focused investigation project designed to streamline evidence review and support a repeatable forensic workflow.', tags:['DFIR','Forensics','Investigation'] },
 { title:'Active Directory Home Lab', meta:'IDENTITY SECURITY', text:'A Windows domain lab for learning enumeration, identity relationships, privilege boundaries, and defensive validation in a controlled environment.', tags:['Active Directory','BloodHound','Windows'] },
];
---
<BaseLayout title="Akhilesh Palve | Cybersecurity Portfolio" description="Cybersecurity portfolio: VAPT, cloud security, digital forensics, and practical security research.">
<section class="hero"><div class="eyebrow">Cybersecurity · Security Engineering · Research</div><h1>Find the weakness.<br /><span class="accent">Understand the why.</span></h1><p class="lead">I'm Akhilesh Palve, a cybersecurity graduate focused on offensive security, vulnerability assessment, cloud security, and practical security automation. I like to understand how systems fail—and how to make them harder to break.</p><div class="hero-actions"><a class="button primary" href="#projects">Explore projects ↘</a><a class="button" href="/blog/">Read field notes ↗</a><a class="button" href="https://github.com/Akhileshpalve89" target="_blank" rel="noreferrer">GitHub ↗</a></div><div class="terminal" aria-label="Terminal introduction"><div class="terminal-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span style="margin-left:8px">akhil@security-lab: ~</span></div><div class="terminal-body"><div><span class="prompt">$</span> whoami</div><div class="output">akhilesh-palve / cybersecurity &amp; forensics</div><div><span class="prompt">$</span> cat focus.txt</div><div class="output">offensive-security · cloud-security · automation · DFIR</div><div><span class="prompt">$</span> printf "learn → validate → document → improve"</div><div class="output">learn → validate → document → improve</div><div><span class="prompt">$</span> <span class="muted">_</span></div></div></div></section>
<section class="section" id="about"><div class="split"><div><div class="eyebrow">01 / About</div><h2>Curiosity, with a method.</h2></div><div><p>I completed my B.Tech in Computer Science &amp; Engineering, specializing in Cybersecurity and Forensics at MIT ADT University, Pune. My experience spans hands-on VAPT, security labs, threat-intelligence workflows, and Python-based automation.</p><p>My approach is evidence-first: understand the environment, validate what a tool reports, explain real impact, and make remediation actionable. I'm also building my knowledge of defensive security and SOC operations.</p><div class="tag-list"><span class="tag">MIT ADT University</span><span class="tag">VAPT</span><span class="tag">Cloud Security</span><span class="tag">Python Automation</span><span class="tag">DFIR</span></div></div></div></section>
<section class="section" id="work"><div class="section-head"><div><div class="eyebrow">02 / Experience</div><h2>Work &amp; collaboration</h2></div><p>Hands-on internships, security research, and team collaboration across vulnerability assessment and cloud security.</p></div><div class="grid"><article class="card"><div class="card-meta">VAPT · Cloud Security</div><h3>CyArt — VAPT Intern &amp; Team Lead</h3><p>Contributed to vulnerability assessments and Python-based cloud security automation, and coordinated technical mentoring and collaboration across a team of interns.</p><div class="tag-list"><span class="tag">Vulnerability Assessment</span><span class="tag">Python</span><span class="tag">Cloud Security</span></div></article><article class="card"><div class="card-meta">Practical Labs · Research</div><h3>Independent security practice</h3><p>Built Windows and Linux labs to explore vulnerability root causes, Active Directory relationships, attack paths, and defensive validation in controlled environments.</p><div class="tag-list"><span class="tag">Home Labs</span><span class="tag">AD</span><span class="tag">Security Research</span></div></article></div><p style="margin-top:18px;font-size:.88rem">The original portfolio remains available with the full experience timeline, achievements, certifications, and supporting details. <a class="back-link" href="/portfolio-original.html">Open the complete original portfolio ↗</a></p></section>
<section class="section" id="projects"><div class="section-head"><div><div class="eyebrow">03 / Selected work</div><h2>Projects &amp; labs</h2></div><p>Practical systems and labs built to learn how attacks work and how security controls can be improved.</p></div><div class="grid">{projects.map((project) => <article class="card"><div class="card-meta">{project.meta}</div><h3>{project.title}</h3><p>{project.text}</p><div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></article>)}</div></section>
<section class="section" id="skills"><div class="split"><div><div class="eyebrow">04 / Toolkit</div><h2>Tools are useful.<br />Judgement is essential.</h2><p>Use tools to build evidence, not to replace reasoning.</p></div><div class="skill-groups"><div class="skill-group"><h3>OFFENSIVE SECURITY</h3><p>Nmap, Burp Suite, Metasploit, Nessus, OWASP ZAP, Kali Linux</p></div><div class="skill-group"><h3>DEFENSE &amp; MONITORING</h3><p>Splunk, Wireshark, SIEM concepts, MITRE ATT&amp;CK, incident triage</p></div><div class="skill-group"><h3>CLOUD &amp; VULNERABILITY</h3><p>AWS security, CSPM concepts, CVE/CVSS analysis, risk prioritization</p></div><div class="skill-group"><h3>CODE &amp; AUTOMATION</h3><p>Python, Bash, JavaScript, Git, Linux, security automation</p></div></div></div></section>
<section class="section" id="blog"><div class="section-head"><div><div class="eyebrow">05 / Field notes</div><h2>Learn it. Test it. Write it down.</h2></div><a class="back-link" href="/blog/">All articles ↗</a></div><div class="post-list">{posts.map((post) => <a class="post-row" href={'/blog/' + post.slug + '/'}><div class="post-date">{post.data.pubDate.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'})}</div><div><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="tag-list">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div><span class="post-arrow">↗</span></a>)}</div></section>
<section class="section" id="contact"><div class="contact-panel"><div><div class="eyebrow">06 / Contact</div><h2>Let's build safer systems.</h2><p>Open to entry-level opportunities in cybersecurity, security engineering, cloud security, and related roles.</p></div><div class="hero-actions"><a class="button primary" href="https://www.linkedin.com/in/akhilesh-palve" target="_blank" rel="noreferrer">Connect on LinkedIn ↗</a><a class="button" href="https://github.com/Akhileshpalve89" target="_blank" rel="noreferrer">GitHub ↗</a><a class="button" href="/Profile.pdf">Resume PDF ↗</a></div></div></section>
</BaseLayout>
